# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- GitHub ---------------------------------------------------------------
# Optional but strongly recommended: raises the rate limit from 60 to 5000 req/hr.
# Fine-grained PAT with "Public repositories (read-only)" access is enough.
GITHUB_TOKEN=

# --- Gemini (used by ai-service for embeddings + match reasons) ----------
# Option A: Vertex AI (uses Application Default Credentials / a service account)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Option B: Google AI Studio key instead of Vertex
# GOOGLE_GENAI_USE_VERTEXAI=false
# GEMINI_API_KEY=

LLM_MODEL=gemini-3.1-pro-preview
# Preview models are often only served from the global endpoint; embeddings use GOOGLE_CLOUD_LOCATION.
LLM_LOCATION=global
EMBEDDING_MODEL=gemini-embedding-001

# --- Postgres --------------------------------------------------------------
POSTGRES_USER=repomatch
POSTGRES_PASSWORD=repomatch
POSTGRES_DB=repomatch

# --- Job alerts & tracker ----------------------------------------------------
# Where links in alert emails point (the deployed frontend).
APP_BASE_URL=
# Random strings. The cron secret guards the scheduled refresh; the link secret signs tracker links in emails.
JOBS_CRON_SECRET=
TRACKER_LINK_SECRET=
# Email is optional — without it, alerts still appear in the app.
# Gmail: MAIL_USERNAME is your address and MAIL_PASSWORD is an App Password
# (Google Account → Security → 2-Step Verification → App passwords), never your real password.
MAIL_FROM=
MAIL_USERNAME=
MAIL_PASSWORD=
